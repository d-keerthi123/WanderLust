<% layout("./layouts/boilerplate.ejs")%>
<!-- <body> -->
    <br>
    <div class="row">
        <div class="col-8 offset-3">
    <h3><b><%= listing.title%> </b></h3>
    </div>
    <div class="card col-6 offset-3 show-card">
        <img src="<%=listing.image.url%>" class="card-img-top show-img" alt="listing_img" >
        <div class="card-body">
        <p class="card-text">
            <%= listing.description%><br>
            &#8377;<%= Number(listing.price).toLocaleString("en-IN") %><br>
            <%= listing.location%><br>
            <%= listing.country%><br>
        </p>
  </div>
    </div>
    <div class="btns">
    <a href="/listings/<%= listing._id%>/edit" class="btn btn-dark  offset-3 edit-btn ">Edit</a>

    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn btn-dark  offset-5">Delete </button>
    </form>
    </div>
    
    <div class="col-8 offset-3 mb-3">
        <hr>
        <h4>Leave a review</h4>
        <form action="/listings/<%=listing._id%>/reviews" method="POST" class="needs-validation" novalidate >
            <div class="mb-3 mt-3">
                <label for="rating"  class="form-label">Rating</label>
                <input type="number" min="1" max="5" id="rating" name="review[rating]"  class="form-control" required>
            </div>
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea name="review[comment]"  id="comment" rows="5" cols="30" class="form-control" required></textarea>
                <div class="valid-feedback"> Looks Good!</div>
                <div class="invalid-feedback">Please add a comment for review.</div>
            </div>
            <br>
            <button class="btn btn-outline-dark">submit</button>
        </form>


        <hr>

<h4><b>All Reviews!!</b></h4>

<div class="row">
    <% for(let review of listing.reviews){ %>

        <div class="col-6 mb-3">
            <div class="card review-card">
                <div class="card-body">
                    <h5 class="card-title">Keerthi D</h5>

                    <p class="card-text">
                        <%= review.comment %>
                    </p>

                    <p class="card-text">
                        <%= review.rating %> stars
                    </p>
                </div>
                <form class="mb-2" method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                    <button class="btn btn-sm btn-dark ms-2 mb-2">Delete</button>
                </form>
            </div>
        </div>

    <% } %>
</div>
    </div>
    </div>
 
