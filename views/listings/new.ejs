<% layout("./layouts/boilerplate.ejs")%>
<div class="row">
<!-- <body> -->
    <div class="col-8 offset-2">
        <br>
    <h3>
        Create new listing!
    </h3>
    <form method="POST" action="/listings"> 
        <div class="mb-3">
            <label for="title" class="form-label" >Title</label>
            <input name="listing[title]" placeholder="enter title" type ="text"  class="form-control">
        </div>
        
        <div>
            <label for="description" class="form-label" >Description</label>
            <textarea name="listing[description]" placeholder="Type a description" rows="5" cols="30" class="form-control"></textarea>
        </div>
        
        <div>
            <label for="image" class="form-label" >Image Link</label>
            <input name="listing[image]" placeholder="enter url/link" type="text" class="form-control" >
        </div>
        <div class="row">
        <div class="mb-3 col-md-4">
            <label for="price" class="form-label" >Price</label>
            <input name="listing[price]" placeholder="enter price" type="number" class="form-control">
        </div>
    
        <div class="mb-3 col-md-8">
             <label for="country" class="form-label" >Country</label>
            <input name="listing[country]" placeholder="enter country" type="text" class="form-control">
         </div>
         </div>
         <div>
            <label for="location" class="form-label" >Location</label>
            <input name="listing[location]" placeholder="enter location" type="text" class="form-control">
         </div>
        
        <br>
        <button class="btn btn-dark add-btn">Add</button>
        <br>
        <br>
    </form>
</div>
</div>
