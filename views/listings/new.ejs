<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>
<body>
    <h3>
        Create new listing!
    </h3>
    <form method="POST" action="/listings"> 
        <input name="listing[title]" placeholder="enter a title" type="text"> 
        <br>
        <br>
        <textarea name="listing[description]" placeholder="Type a description" rows="10" cols="30"></textarea>
        <br>
         <br>
        <input name="listing[image]" placeholder="enter url/link" type="number" >
        <br>
         <br>
        <input name="listing[price]" placeholder="enter price" >
        <br>
         <br>
        <input name="listing[location]" placeholder="enter loaction" type="text">
        <br>
         <br>
        <input name="listing[country]" placeholder="enter country" type="text">
        <br>
        <br>
        <button>Add</button>
    </form>
</body>
</html>